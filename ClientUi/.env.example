# Leave the URLs relative: the Vite dev server forwards /api and /socket.io to the backend (see vite.config.js),
# so the site works on localhost and from other devices by IP address. For a production build served
# from a different host than the API, set full URLs, e.g. VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_CURRENCY=USD
