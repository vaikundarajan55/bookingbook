PORT=5000
NODE_ENV=development
CLIENT_URLS=http://localhost:5178,http://127.0.0.1:5178

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_booking

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin account (saved by `npm run db:init` and on every server start)
ADMIN_EMAIL=admin@hotel.com
ADMIN_PASSWORD=Admin@123

# Room prices include tax; invoices show this % as the tax part
TAX_RATE=12

# Email for password resets (leave SMTP_HOST empty in development: the link is logged and shown on screen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Harbourline Hotel <no-reply@harbourline.example>
