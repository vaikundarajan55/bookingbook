{
  "name": "serverui",
  "version": "1.0.0",
  "description": "Hotel Booking API - Node.js (ES modules / ES2017+), Express, MySQL, Socket.io, MVC",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
